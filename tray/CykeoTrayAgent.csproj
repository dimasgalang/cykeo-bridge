<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CykeoTrayAgent</AssemblyName>
    <RootNamespace>CykeoBridge.Tray</RootNamespace>
    <LangVersion>7.3</LangVersion>

    <!-- WAJIB x86: install_cykeo.ps1 membuang exe yang bukan PE32 (0x014C),
         karena SDK production GReaderApi.dll juga 32-bit. -->
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>

    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CS0168;CS0219;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TrayAgent.cs" />
    <!-- v1.6.24: wizard konfigurasi GUI native (WinForms) menyatu di
         tray agent, jadi tidak butuh exe terpisah. File ini WAJIB ikut
         di build: install_tray.ps1 mengompilasi dengan csc.exe dari
         daftar file eksplisit, dan file yang tidak ikut = form wizard
         tidak ada di PC user. -->
    <Compile Include="ConfigureDialog.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
